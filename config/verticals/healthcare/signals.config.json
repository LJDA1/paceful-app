{
  "vertical": "healthcare",
  "version": "1.0.0",
  "display_name": "Healthcare & Therapy Intelligence",
  "description": "Emotional readiness signals for clinical platforms. Focuses on distress detection, treatment adherence, and patient engagement \u2014 calibrated to be clinically useful without attempting crisis detection. Signals are anchored to validated clinical frameworks where applicable.",
  "ers_dimensions": [
    "emotional_stability",
    "self_reflection",
    "coping_capacity",
    "behavioral_engagement",
    "social_readiness"
  ],
  "clinical_note": "This vertical pack INTENTIONALLY EXCLUDES signals for suicidal ideation, self-harm, or acute psychiatric crisis. Crisis detection requires validated clinical instruments (C-SSRS, PHQ-9 Item 9) administered under clinical supervision, not text-inference heuristics. Platforms requiring crisis detection should use validated screeners and human clinical review, and may engage Paceful separately for a clinically-reviewed 'Clinical Plus' pack once available. All signals below are decision-support for clinical workflows, not clinical verdicts.",
  "signals": [
