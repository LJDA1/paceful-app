    "emotional_stability",
    "self_reflection",
    "coping_capacity",
    "behavioral_engagement",
    "social_readiness"
  ],
  "signals": [
    {
      "id": "DAT-001",
      "name": "harassment_escalation",
      "display_name": "Harassment Escalation",
      "category": "behavioral_engagement",
      "description": "Detection of language patterns that suggest escalating harassment, persistent unwanted contact, or refusal to accept rejection.",
      "severity_levels": {
        "low": {
          "range": [
            0,
            0.3
          ],
          "label": "No indicators",
          "action": "Standard handling"
        },
        "medium": {
          "range": [
            0.3,
            0.6
          ],
          "label": "Persistent contact",
          "action": "Flag for T&S review"
        },
        "high": {
          "range": [
            0.6,
            0.8
          ],
          "label": "Escalating harassment",
          "action": "Priority T&S review + intervention options to recipient"
        },
        "critical": {
          "range": [
            0.8,
            1.0
          ],
          "label": "Severe harassment",
          "action": "Immediate T&S action + safety resources to recipient"
        }
      },
      "indicators": {
        "linguistic_markers": [
          "answer me",
          "why are you ignoring",
          "respond",
          "stop ignoring",
          "you owe me",
          "after everything",
          "i know where",
          "i saw you",
          "don't ignore me",
          "pick up",
          "call me back",
          "i deserve"
        ],
        "behavioral_patterns": [
          "uppercase_usage_increase",
          "exclamation_mark_density",
          "repeated_questions_on_same_topic",
          "ultimatum_frequency"
        ]
      },
      "weight": 0.15
    },
