{
  "vertical": "dating",
  "version": "1.0.0",
  "display_name": "Dating Platform Intelligence",
  "description": "Emotional readiness and safety signals for dating platforms. Detects coercion, harassment escalation, emotional manipulation, and identifies positive connection quality. Signals are decision-support tools for trust & safety teams, not automated actions against users.",
